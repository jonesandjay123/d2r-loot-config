{
  "name": "Bot Item Marker",
  "description": "在所有物品名稱前後加上亮綠色【】標記，方便 bot 偵測",
  "author": "Jarvis",
  "website": "https://github.com/jonesandjay123/d2r-bot-research",
  "version": "1.0.0",
  "config": [
    {
      "id": "markerColor",
      "name": "標記顏色代碼",
      "description": "ÿc0=白, ÿc1=紅, ÿc2=亮綠, ÿc3=藍, ÿc4=金, ÿc8=橘, ÿc9=黃, ÿc;=紫",
      "type": "string",
      "defaultValue": "ÿc2"
    },
    {
      "id": "markerLeft",
      "name": "左側標記符號",
      "description": "物品名前面加的符號",
      "type": "string",
      "defaultValue": "【"
    },
    {
      "id": "markerRight",
      "name": "右側標記符號",
      "description": "物品名後面加的符號",
      "type": "string",
      "defaultValue": "】"
    }
  ]
}
